[Unit]
Description=vDS userspace daemon
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=simple
# vhci_hcd (in-tree USB/IP host driver) carries the virtual controllers; the
# out-of-tree vds_hcd module is only used when it is already loaded.
ExecStartPre=-modprobe vhci-hcd
ExecStart=@VDS_SYSTEMD_VDSD@
Restart=on-failure
RestartSec=1s

[Install]
WantedBy=multi-user.target
